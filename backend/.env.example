# =============================================================================
# GeM Tender Compliance Backend - Environment Variables Configuration (.env.example)
# =============================================================================
# Copy this file to .env for local development.
# NEVER commit .env or service account JSON files to version control.
#
# On Render / Cloud deployment, set these in Render Dashboard -> Environment Variables.
# =============================================================================

# ─── 1. Firebase / Firestore Configuration ────────────────────────────────────
FIREBASE_PROJECT_ID=bidder-fdede
FIRESTORE_DATABASE_ID=(default)

# ─── 2. Google Service Account Credentials ─────────────────────────────────────
# For Render / Cloud Run: Paste the base64-encoded service account JSON string here.
# Generate locally using:
#   Linux/Mac: base64 -w0 credentials/bidder-fdede-b13f4f369c8a.json
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("credentials/bidder-fdede-b13f4f369c8a.json"))
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=your_base64_encoded_service_account_json_here

# For Local Development (Alternative to base64): Path relative to backend directory
# FIREBASE_CREDENTIALS_PATH=credentials/bidder-fdede-b13f4f369c8a.json
# GOOGLE_APPLICATION_CREDENTIALS=credentials/bidder-fdede-b13f4f369c8a.json

# ─── 3. Google Drive Configuration ─────────────────────────────────────────────
# Root folder ID where tenders and uploaded application PDFs are stored
GOOGLE_DRIVE_ROOT_FOLDER_ID=1Avm4vK0pwYcbaKvaqz5pXpUgsxuRULi4

# ─── 4. Government Verification Google Sheets Datasets ─────────────────────────
# Simulated DigiLocker government verification datasets on Google Drive / Sheets
#
# PAN: Sheet "PAN Details"
GOOGLE_SHEET_PAN_ID=1S4f3wEKykvZ7LSM8vA129YqNKK9q3dlj
#
# UDYAM: Sheet "S.No.,Udyam Registration Number"
GOOGLE_SHEET_UDYAM_ID=1BaLtUC4K7R89UmFK3vHkyGAB-c0HmKNV
#
# GST: Sheet "GST_Details"
GOOGLE_SHEET_GST_ID=1EsWtSXWNNNwXcgG1wIhmGIQTJ6Tq89B8
#
# OEM: Sheet "S.No.,Authorization Number,Comp"
GOOGLE_SHEET_OEM_ID=1Vo78YziNt6o4LN4d2BzuwVaPvugFaSOF

# ─── 5. Server & Runtime Configuration ────────────────────────────────────────
ENVIRONMENT=production
PORT=8080
LOG_LEVEL=INFO
